---
import Layout from '../layouts/Layout.astro';
import HeroImageReceita from '../components/receitaComponent/HeroImageReceitas.astro';
import MainContent from '../components/receitaComponent/MainContent.astro';
import FooterContent from '../components/receitaComponent/FooterContent.astro';
import Receitas from '../data/receitas.json';

export function getStaticPaths(){
  return Receitas.map(({
    slug, 
    titulo, 
    imagem, 
    descricao, 
    tempoPreparo, 
    nivel, 
    categoria, 
    rendimento,
    ingredientes,
    preparo,
    molho,
    acompanhamento
  }) =>{
    return{
      params: {slug},
      props: {
        titulo, 
        imagem,
        descricao,
        tempoPreparo,
        nivel,
        categoria,
        rendimento,
        ingredientes,
          preparo,
          molho,
          acompanhamento
      }
    }
  })
}

const {
  titulo, 
  imagem, 
  descricao, 
  tempoPreparo,
  nivel,
  categoria,
  rendimento,
  ingredientes,
  preparo,
  molho,
  acompanhamento
} = Astro.props;
---
<Layout title={titulo}>
  <HeroImageReceita 
    imagem={imagem} 
    titulo={titulo} 
    descricao={descricao} 
    tempoPreparo={tempoPreparo}
    nivel={nivel}
    categoria={categoria}
    rendimento={rendimento}
  />
  <MainContent ingredientes={ingredientes} preparo={preparo} molho={molho} acompanhamento={acompanhamento}/>
  <FooterContent/>
</Layout>
