---
interface Props {
titulo: string;
imagem: string;
descricao: string;
tempoPreparo: string;
nivel: string;
categoria: string;
rendimento: string;
}

const {
titulo, 
imagem, 
descricao, 
tempoPreparo,
nivel,
categoria,
rendimento
} = Astro.props;
---
<section class="p-10">
  <article class="grid grid-cols-3 gap-10">
    <div class="col-span-2 w-full outline-1 outline-gray-300 rounded-xl p-2 shadow-md">
      <img src={imagem} alt={titulo} class="w-full h-150 rounded-xl object-cover">
    </div>
    <div class="col-span-1 outline-1 outline-gray-300 rounded-xl p-10 shadow-md">
      <div class="mb-5">
        <h1 class="font-bold font-serif text-xl text-[#642a1c] mb-5">{titulo}</h1>
        <p class=" text-sm">{descricao}</p>
      </div>
      <div class="grid grid-cols-1 gap-2 text-xs text-gray-500 outline-1 outline-gray-300 rounded-xl shadow-sm p-2 mb-10">
        <div class="grid grid-cols-2 border-b border-gray-200 items-center p-2">
          <b>Tempo de preparo:</b>
          <b>{tempoPreparo}</b>
        </div>
        <div class="grid grid-cols-2 border-b border-gray-200 items-center p-2">
          <b>Nível:</b>
          <b>{nivel}</b>
        </div>
        <div class="grid grid-cols-2 border-b border-gray-200 items-center p-2">
          <b>Categoria:</b>
          <b>{categoria}</b>
        </div>
        <div class="grid grid-cols-2 items-center p-2">
          <b>Porções:</b>
          <b>{rendimento}</b>
        </div>
      </div>
      <div class="w-full">
        <!-- ShareThis BEGINS -->
        <div class="sharethis-share-buttons" data-type="inline-share-buttons">
        <span data-network="facebook"></span>
        <span data-network="twitter"></span>
        <span data-network="pinterest"></span>
        <span data-network="whatsapp"></span>
        <span data-network="sharethis"></span>
        </div>
        <!-- ShareThis ENDS -->
      </div>
    </div>
  </article>
</section>
