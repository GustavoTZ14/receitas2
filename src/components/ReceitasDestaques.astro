---
import Receitas from '../data/receitas.json';
import { Clock, TrendingUp, SquareMenu, ChevronRight } from 'lucide-react';

const topReceitas = Receitas.slice(0, 4)
---
<section class="flex justify-center p-5 mb-10">
  <article>
    <div class="flex justify-between mb-5">
      <div>
        <h1 class="font-bold text-xl font-serif">Receitas em destaques</h1>
      </div>
      <div>
        <a href="#" class="italic font-serif text-sm flex items-center">Veja todas as receitas<ChevronRight/></a>
      </div>
    </div>

    <div class="flex gap-5">
      {topReceitas.map(({titulo, slug, imagem, tempoPreparo, nivel, categoria}) =>(
      <a href={slug}>
        <div class="w-80 h-100 outline-1 outline-gray-200 rounded-xl shadow-sm bg-white">
          <div class="w-full h-80 rounded-t-xl p-2">
            <img src={imagem} alt={titulo} class="w-full h-full rounded-t-xl object-cover">
          </div>
          <div class="grid grid-cols-1 items-center w-full p-2">
            <h1 class="font-sans text-base text-center font-bold truncate mb-2" title={titulo}>{titulo}</h1>
            <div class="flex items-center w-full h-full p-2 justify-center font-serif gap-1">
              <div class="flex p-2 h-7 gap-1 justify-center items-center text-xs text-[#642a1c]">
                <Clock className='size-4'/><b title={tempoPreparo}>{tempoPreparo}</b>
              </div>
              <div class="flex p-2 h-7 gap-1 justify-center items-center text-xs text-[#642a1c]">
                <TrendingUp className='size-4'/><b title={nivel}>{nivel}</b>
              </div>
              <div class="flex p-2 h-7 gap-1 justify-center items-center text-xs text-[#642a1c]">
                <SquareMenu className='size-4'/><b title={categoria}>{categoria}</b>
              </div>
            </div>
          </div>
        </div>
      </a>
      ))}
    </div>
  </article>
</section>
