---
import Receitas from '../data/receitas.json';
import { Clock, TrendingUp, ListSortDescending, ChevronRight } from 'lucide-react';

const topReceitas = Receitas.slice(0, 4)
---
<section class="flex justify-center p-5 mb-10">
  <article>
    <div class="flex justify-between mb-5">
      <div>
        <h1 class="font-bold text-xl font-serif">Receitas em destaques</h1>
      </div>
      <div>
        <a href="#" class="italic font-serif text-sm flex items-center">Veja todas as receitas<ChevronRight/></a>
      </div>
    </div>

    <div class="flex gap-5">
      {topReceitas.map(({titulo, slug, imagem, tempoPreparo, nivel, categoria}) =>(
      <a href={slug}>
        <div class="w-80 h-100 outline-1 outline-gray-200 rounded-xl shadow-sm">
          <div class="w-full h-80 rounded-t-xl p-2">
            <img src={imagem} alt={titulo} class="w-full h-full rounded-t-xl object-cover">
          </div>
          <div class="grid grid-cols-1 items-center w-full p-2">
            <h1 class="font-sans text-base text-center font-bold truncate" title={titulo}>{titulo}</h1>
            <div class="flex items-end w-full h-full p-2 justify-center font-serif gap-1">
              <div class="flex p-2 h-7 gap-2 justify-center items-center text-sm text-gray-500">
                <Clock className='w-5'/><b class="mt-2">{tempoPreparo}</b>
              </div>
              <div class="flex p-2 h-7 gap-2 justify-center items-center text-sm text-gray-500">
                <TrendingUp className='w-5'/><b class="mt-2">{nivel}</b>
              </div>
              <div class="flex p-2 h-7 gap-2 justify-center items-center text-sm text-gray-500">
                <ListSortDescending className='w-5'/><b class="mt-2">{categoria}</b>
              </div>
            </div>
          </div>
        </div>
      </a>
      ))}
    </div>
  </article>
</section>
