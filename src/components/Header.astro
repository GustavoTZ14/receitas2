---
import ImageLogo from './ImageLogo.astro';
import { Search } from 'lucide-react';
---
<header class="p-5 bg-[#fffaf9]">
  <div class="flex justify-around items-center">
    <div class="w-40">
      <a href="/">
        <ImageLogo/>
      </a>
    </div>
    <div id="search" class="w-150 relative">
      <form id="form" class="flex outline-1 outline-gray-300 bg-white rounded-xl h-10 p-2 mb-2">
        <input type="text" id="inSearch" placeholder="Pesquise por receitas ..." class="w-full h-full outline-hidden">
        <Search/>
      </form>
      <div id="resultado" class="hidden absolute w-full max-h-100 bg-white outline-1 outline-gray-200 rounded-xl p-2"></div>
    </div>
  </div>
  <script src="../scripts/search.js"></script>
</header>
