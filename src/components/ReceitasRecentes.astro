---
import Receitas from '../data/receitas.json';
import { Clock, TrendingUp, ListSortDescending, ChevronRight } from 'lucide-react';

const ultimasReceitas = Receitas.slice(-4)
---
<section class="flex justify-center p-10 bg-[#fffaf9]">
  <article>
    <div class="flex justify-between items-center mb-5">
      <div>
        <h1 class="font-bold text-xl font-serif">Últimas receitas</h1>
      </div>
      <div>
        <a href="#" class="italic font-serif text-sm flex items-center">Veja todas as receitas<ChevronRight/></a>
      </div>
    </div>
    <div class="flex gap-2">
      {ultimasReceitas.map(({titulo, slug, imagem, tempoPreparo, nivel, categoria})=>(
      <div class="grid grid-cols-2 gap-2 outline-1 outline-gray-200 rounded-xl p-2 w-100 shadow-sm bg-gray-50">
        <div class="w-full h-50">
          <img src={imagem} alt={titulo} class="w-full h-full rounded-xl object-cover">
        </div>
        <div>
          <h1 class="font-bold text-base mb-5">{titulo}</h1>
          <div class="grid grid-cols-1 gap-2">
            <div>
              <b class="text-xs text-gray-500 flex gap-1 items-center"><Clock className="size-4"/>{tempoPreparo}</b>
            </div>
            <div>
              <b class="text-xs text-gray-500 flex gap-1 items-center"><TrendingUp className="size-4"/>{nivel}</b>
            </div>
            <div>
              <b class="text-xs text-gray-500 flex gap-1 items-center"><ListSortDescending className="size-4"/>{categoria}</b>
            </div>
          </div>
        </div>
      </div>
      ))}
    </div>
  </article>
</section>
