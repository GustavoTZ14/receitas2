      </p>
    </div>
    <div>
      <h1>Links rápidos</h1>
      <ul>
        <li>Inicio</li>
        <li>Receitas</li>
        <li>Categorias</li>
        <li>Sobre</li>
        <li>Contato</li>
      </ul>
    </div>
    <div>
      <h1>Categorias populares</h1>
      <ul>
        <li>Bolos e Tortas</li>
        <li>Carnes</li>
        <li>Massas</li>
        <li>Sobremesas</li>
        <li>Saladas</li>
      </ul>
    </div>
  </nav>
</footer>
